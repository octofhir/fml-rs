              "defaultValue": "'x'",
              "element": "code",
              "listMode": "first",
              "variable": "c",
              "condition": "c.length() > 1",
              "check": "$this != ''",
              "logMessage": "c"
            }
          ],
          "target": [
            {
              "context": "tgt",
              "element": "code",
              "transform": "copy",
