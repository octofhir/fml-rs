---
source: crates/fml-model/tests/compile.rs
expression: "map_json(r#\"group G(source src, target tgt) extends Base <<type+>> {\n  // copy the value\n  src.value : string as v -> tgt.text = v;\n  src.a.b.c as x -> tgt.p.q = x \"deep-path\";\n  src.code 0..1 first default ('x') as c where (c.length() > 1) check ($this != '') log (c) -> tgt.code = c \"constraints\";\n  src -> tgt.extension as ext, ext.url = 'http://example.org', ext.value = create('Reference') as r share refs, r.reference = reference(src) \"creates\";\n  src.n as n -> tgt.n = (n + 1), tgt.m = evaluate(n, n * 2), tgt.k = 5, tgt.flag = true \"evaluates\";\n  src.name as sn -> tgt.name as tn then {\n    sn.family as f -> tn.family = f \"family\";\n  } \"names\";\n  src.contact as s -> tgt.contact as t then Contact(s, t, 'x') \"dependent\";\n  src.legacy default \"fallback\" as l -> tgt.legacy = l \"legacyDefault\";\n}\n\"#)"
---
{
  "resourceType": "StructureMap",
  "status": "draft",
  "group": [
    {
      "name": "G",
      "extends": "Base",
      "typeMode": "type-and-types",
      "input": [
        {
          "name": "src",
          "mode": "source"
        },
        {
          "name": "tgt",
          "mode": "target"
        }
      ],
      "rule": [
        {
          "name": "valueString",
          "source": [
